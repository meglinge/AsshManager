# Local: npm run build && node --env-file=.env --import tsx server/index.ts
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Production: set NODE_ENV=production and use an HTTPS PUBLIC_URL.
# ENCRYPTION_KEY must be 64 hex characters; generate with: openssl rand -hex 32
# Store this key in your secret manager, separately from database backups.
# ENCRYPTION_KEY=
# Set only when exactly one trusted reverse proxy is in front of the app.
TRUST_PROXY=0
REGISTRATION_ENABLED=true
# Optional: true requires mailbox verification before using Web/MCP. Restart after changes.
EMAIL_VERIFICATION_REQUIRED=false
# Optional explicit private networks accessible to SSH, e.g. 10.20.0.0/16.
# Public unicast addresses are allowed by default. Metadata/link-local is always blocked.
SSH_ALLOWED_CIDRS=
# SMTP: 465 uses implicit TLS; other ports require STARTTLS with valid certificates.
# Without SMTP_HOST, non-production writes private mail JSON files to DATA_DIR/mail.
# SMTP is optional in production unless EMAIL_VERIFICATION_REQUIRED=true.
# Without SMTP_HOST, production disables mail delivery (no local mail files).
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_FROM=AsshManager <noreply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
