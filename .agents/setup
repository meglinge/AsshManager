#!/usr/bin/env bash
set -euo pipefail

echo 'Checking Node.js (22.13+ required)'
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 13)) throw new Error("Install Node.js 22.13 or newer")'
if ! test -x /usr/sbin/sshd; then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq openssh-server
fi
sudo mkdir -p /run/sshd
echo 'Installing locked dependencies'
npm ci --no-fund
echo 'Building AsshManager'
npm run build
